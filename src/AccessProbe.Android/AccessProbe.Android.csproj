    <Compile Include="../AccessProbe/MetadataPlatformDomain.cs" Link="Shared/MetadataPlatformDomain.cs" />
    <Compile Include="../AccessProbe/MetadataPlatformParser*.cs" Link="Shared/%(Filename)%(Extension)" />
    <Compile Include="../AccessProbe/MetadataHttpReader*.cs" Link="Shared/%(Filename)%(Extension)" />
    <Compile Include="../AccessProbe/MetadataSessionStore.cs" Link="Shared/MetadataSessionStore.cs" />
    <Compile Include="../AccessProbe/MetadataSynchronizer*.cs" Link="Shared/%(Filename)%(Extension)" />
    <Compile Include="../AccessProbe/MetadataTaskNavigation*.cs" Link="Shared/%(Filename)%(Extension)" />
    <Compile Include="../AccessProbe/MetadataFailureText.cs" Link="Shared/MetadataFailureText.cs" />
