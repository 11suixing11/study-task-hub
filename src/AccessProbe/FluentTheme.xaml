<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:local="clr-namespace:AccessProbe">
 <ResourceDictionary.MergedDictionaries>
  <ui:ThemesDictionary Theme="Light" />
  <ui:ControlsDictionary />
  <ResourceDictionary Source="Themes/CheckBox.xaml" />
  <ResourceDictionary Source="Themes/MacControls.xaml" />
 </ResourceDictionary.MergedDictionaries>

 <!-- macOS HIG-inspired hierarchy, adapted to Windows system fonts and WPF. -->
 <FontFamily x:Key="AppFontFamily">Segoe UI, Microsoft YaHei UI</FontFamily>
 <SolidColorBrush x:Key="PrimaryBrush" Color="#006BE6" />
 <SolidColorBrush x:Key="InkBrush" Color="#202C3D" />
 <SolidColorBrush x:Key="MutedBrush" Color="#5E6B80" />
 <SolidColorBrush x:Key="CanvasBrush" Color="#F5F8FF" />
 <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
 <SolidColorBrush x:Key="LineBrush" Color="#DAE3F2" />
 <SolidColorBrush x:Key="SubtleBrush" Color="#F5F8FF" />
 <SolidColorBrush x:Key="PrimarySoftBrush" Color="#E4EEFF" />
 <SolidColorBrush x:Key="SuccessBrush" Color="#087A3A" />
 <SolidColorBrush x:Key="SuccessSoftBrush" Color="#DFF6E8" />
 <SolidColorBrush x:Key="WarningBrush" Color="#9A5200" />
 <SolidColorBrush x:Key="WarningSoftBrush" Color="#FFF0CC" />
 <SolidColorBrush x:Key="DangerBrush" Color="#C9243A" />
 <SolidColorBrush x:Key="DangerSoftBrush" Color="#FFE5EA" />
 <SolidColorBrush x:Key="SidebarMaterialBrush" Color="#F0F4FC" />
 <SolidColorBrush x:Key="ToolbarMaterialBrush" Color="#F7F9FF" />
 <SolidColorBrush x:Key="SidebarHoverBrush" Color="#E2ECFF" />
 <SolidColorBrush x:Key="SidebarSelectionBrush" Color="#006BE6" />
 <SolidColorBrush x:Key="SidebarIconBrush" Color="#5E6B80" />
 <SolidColorBrush x:Key="RowHoverBrush" Color="#EFF5FF" />
 <SolidColorBrush x:Key="RowSelectionBrush" Color="#DFEBFF" />
 <SolidColorBrush x:Key="InputLineBrush" Color="#B8C9E4" />
 <SolidColorBrush x:Key="InputHoverBrush" Color="#F7FAFF" />
 <SolidColorBrush x:Key="FocusRingBrush" Color="#006BE6" />
 <SolidColorBrush x:Key="BlueIconBrush" Color="#3478F6" />
 <SolidColorBrush x:Key="AmberIconBrush" Color="#C77700" />
 <SolidColorBrush x:Key="RedIconBrush" Color="#E24457" />
 <SolidColorBrush x:Key="GreenIconBrush" Color="#169852" />
 <SolidColorBrush x:Key="IndigoIconBrush" Color="#6558DE" />
 <SolidColorBrush x:Key="PurpleIconBrush" Color="#8150DF" />
 <SolidColorBrush x:Key="CoralIconBrush" Color="#E8553E" />
 <SolidColorBrush x:Key="PinkIconBrush" Color="#D74178" />
 <SolidColorBrush x:Key="TealIconBrush" Color="#008A9A" />
 <LinearGradientBrush x:Key="BrandBrush" StartPoint="0,0" EndPoint="1,1">
  <GradientStop Color="#007AFF" Offset="0"/><GradientStop Color="#6558DE" Offset="1"/>
 </LinearGradientBrush>
 <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>
 <Color x:Key="SystemAccentColor">#006BE6</Color>
 <Color x:Key="SystemAccentColorPrimary">#006BE6</Color>
 <Color x:Key="SystemAccentColorSecondary">#005BCE</Color>
 <Color x:Key="SystemAccentColorTertiary">#004BB4</Color>
 <SolidColorBrush x:Key="SystemAccentColorBrush" Color="#006BE6" />
 <SolidColorBrush x:Key="SystemAccentColorPrimaryBrush" Color="#006BE6" />
 <SolidColorBrush x:Key="SystemAccentColorSecondaryBrush" Color="#005BCE" />
 <SolidColorBrush x:Key="SystemAccentColorTertiaryBrush" Color="#004BB4" />
 <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#005BCE" />
 <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#004BB4" />
 <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#006BE6" />
 <SolidColorBrush x:Key="AccentFillColorSelectedTextBackgroundBrush" Color="#006BE6" />
 <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#006BE6" />
 <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#006BE6" Opacity="0.9" />
 <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#006BE6" Opacity="0.8" />
 <SolidColorBrush x:Key="SystemFillColorAttentionBrush" Color="#006BE6" />
 <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#202C3D" />
 <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#5E6B80" />
 <SolidColorBrush x:Key="TextControlForeground" Color="#202C3D" />
 <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#5E6B80" />
 <SolidColorBrush x:Key="TextControlBackground" Color="#FFFFFF" />
 <SolidColorBrush x:Key="TextControlBorderBrush" Color="#B8C9E4" />

 <Style TargetType="Window" BasedOn="{StaticResource DefaultWindowStyle}">
  <Setter Property="Icon" Value="{x:Static local:ProductIcons.AppImage}" />
  <Setter Property="Background" Value="{StaticResource CanvasBrush}" />
  <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
  <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
  <Setter Property="FontSize" Value="13" />
  <Setter Property="UseLayoutRounding" Value="True" />
 </Style>

 <Style x:Key="FluentButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
  <Setter Property="Border.CornerRadius" Value="6" />
  <Setter Property="Padding" Value="12,5" />
  <Setter Property="Margin" Value="0,0,8,0" />
  <Setter Property="MinHeight" Value="30" />
  <Setter Property="FontWeight" Value="Normal" />
  <Setter Property="FontSize" Value="13" />
  <Setter Property="HorizontalAlignment" Value="Stretch" />
  <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
  <Setter Property="Cursor" Value="Hand" />
 </Style>
 <Style TargetType="Button" BasedOn="{StaticResource FluentButton}" />

 <Style x:Key="FluentUiButton" TargetType="ui:Button" BasedOn="{StaticResource DefaultUiButtonStyle}">
  <Setter Property="CornerRadius" Value="6" />
  <Setter Property="Padding" Value="12,5" />
  <Setter Property="Margin" Value="0,0,8,0" />
  <Setter Property="MinHeight" Value="30" />
  <Setter Property="FontWeight" Value="Normal" />
  <Setter Property="FontSize" Value="13" />
  <Setter Property="HorizontalAlignment" Value="Stretch" />
  <Setter Property="Cursor" Value="Hand" />
  <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
  <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
  <Setter Property="BorderBrush" Value="{StaticResource InputLineBrush}" />
  <Setter Property="MouseOverBackground" Value="{StaticResource SubtleBrush}" />
  <Setter Property="MouseOverBorderBrush" Value="{StaticResource InputLineBrush}" />
  <Setter Property="PressedBackground" Value="{StaticResource SidebarHoverBrush}" />
  <Setter Property="PressedBorderBrush" Value="{StaticResource InputLineBrush}" />
  <Style.Triggers>
   <Trigger Property="Appearance" Value="Primary">
    <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
    <Setter Property="MouseOverBackground" Value="#005BCE" />
    <Setter Property="MouseOverBorderBrush" Value="#005BCE" />
    <Setter Property="PressedBackground" Value="#004BB4" />
    <Setter Property="PressedBorderBrush" Value="#004BB4" />
    <Setter Property="PressedForeground" Value="White" />
   </Trigger>
   <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5" /></Trigger>
  </Style.Triggers>
 </Style>
 <Style TargetType="ui:Button" BasedOn="{StaticResource FluentUiButton}" />
 <Style x:Key="PrimaryButton" TargetType="ui:Button" BasedOn="{StaticResource FluentUiButton}">
  <Setter Property="Appearance" Value="Primary" />
  <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
  <Setter Property="Foreground" Value="White" />
  <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
  <Setter Property="MouseOverBackground" Value="#005BCE" />
  <Setter Property="MouseOverBorderBrush" Value="#005BCE" />
  <Setter Property="PressedBackground" Value="#004BB4" />
  <Setter Property="PressedBorderBrush" Value="#004BB4" />
  <Setter Property="PressedForeground" Value="White" />
 </Style>
 <Style x:Key="SuccessButton" TargetType="ui:Button" BasedOn="{StaticResource FluentUiButton}">
  <Setter Property="Background" Value="{StaticResource SuccessSoftBrush}" />
  <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
  <Setter Property="BorderBrush" Value="#B0E7C3" />
  <Setter Property="FontWeight" Value="SemiBold" />
  <Setter Property="MouseOverBackground" Value="#C8F0DA" />
  <Setter Property="MouseOverBorderBrush" Value="#8ED4AA" />
  <Setter Property="PressedBackground" Value="#B1E8CA" />
  <Setter Property="PressedBorderBrush" Value="#7ACA9B" />
  <Setter Property="PressedForeground" Value="{StaticResource SuccessBrush}" />
 </Style>
 <Style x:Key="TextButton" TargetType="ui:Button" BasedOn="{StaticResource FluentUiButton}">
  <Setter Property="Appearance" Value="Transparent" />
  <Setter Property="Background" Value="Transparent" />
  <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
  <Setter Property="BorderBrush" Value="Transparent" />
  <Setter Property="BorderThickness" Value="0" />
  <Setter Property="MouseOverBackground" Value="{StaticResource SidebarHoverBrush}" />
  <Setter Property="MouseOverBorderBrush" Value="Transparent" />
  <Setter Property="PressedBackground" Value="{StaticResource SidebarHoverBrush}" />
  <Setter Property="PressedBorderBrush" Value="Transparent" />
 </Style>

 <Style TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
  <Setter Property="Border.CornerRadius" Value="6" />
  <Setter Property="Padding" Value="9,5" />
  <Setter Property="MinHeight" Value="30" />
  <Setter Property="VerticalContentAlignment" Value="Center" />
 </Style>
 <Style TargetType="ui:TextBox" BasedOn="{StaticResource DefaultUiTextBoxStyle}">
  <Setter Property="Template" Value="{StaticResource MacUiTextBoxTemplate}" />
  <Setter Property="Border.CornerRadius" Value="6" />
  <Setter Property="Padding" Value="9,5" />
  <Setter Property="MinHeight" Value="30" />
  <Setter Property="VerticalContentAlignment" Value="Center" />
 </Style>
 <Style TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}">
  <Setter Property="MinHeight" Value="30" />
  <Setter Property="Padding" Value="9,5" />
  <Setter Property="Margin" Value="0,0,8,0" />
 </Style>
 <Style TargetType="CheckBox" BasedOn="{StaticResource DefaultCheckBoxStyle}">
  <Setter Property="Template" Value="{StaticResource StableCheckBoxTemplate}" />
  <Setter Property="VerticalContentAlignment" Value="Center" />
  <Setter Property="Padding" Value="6,2" />
 </Style>
 <Style TargetType="Expander" BasedOn="{StaticResource DefaultExpanderStyle}">
  <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  <Setter Property="Padding" Value="0" />
 </Style>
 <Style x:Key="FluentDataGridColumnHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource DefaultDataGridColumnHeaderStyle}">
  <Setter Property="Background" Value="{StaticResource SubtleBrush}" />
  <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
  <Setter Property="Margin" Value="0" />
  <Setter Property="Padding" Value="10,5" />
  <Setter Property="BorderThickness" Value="0" />
  <Setter Property="FontWeight" Value="Normal" />
  <Setter Property="FontSize" Value="11" />
 </Style>
 <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource FluentDataGridColumnHeader}" />
 <Style x:Key="FluentDataGridCell" TargetType="DataGridCell" BasedOn="{StaticResource DefaultDataGridCellStyle}">
  <Setter Property="Padding" Value="10,7" />
  <Setter Property="BorderThickness" Value="0" />
  <Setter Property="VerticalContentAlignment" Value="Center" />
  <Style.Triggers>
   <Trigger Property="IsSelected" Value="True">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
   </Trigger>
  </Style.Triggers>
 </Style>
 <Style TargetType="DataGridCell" BasedOn="{StaticResource FluentDataGridCell}" />
 <Style TargetType="DataGrid" BasedOn="{StaticResource DefaultDataGridStyle}">
  <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
  <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
  <Setter Property="BorderThickness" Value="0" />
  <Setter Property="GridLinesVisibility" Value="None" />
  <Setter Property="RowHeight" Value="56" />
  <Setter Property="ColumnHeaderHeight" Value="28" />
  <Setter Property="RowHeaderWidth" Value="0" />
  <Setter Property="AlternatingRowBackground" Value="{StaticResource SubtleBrush}" />
  <Setter Property="RowStyle" Value="{StaticResource MacDataGridRow}" />
  <Setter Property="Border.CornerRadius" Value="0" />
  <Setter Property="CellStyle" Value="{StaticResource FluentDataGridCell}" />
  <Setter Property="ColumnHeaderStyle" Value="{StaticResource FluentDataGridColumnHeader}" />
 </Style>
</ResourceDictionary>
